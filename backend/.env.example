# SignalMesh AI Backend — Environment Configuration
# Copy this file to .env and fill in your actual Snowflake credentials
# NEVER commit .env to git — it is git-ignored for security

# Snowflake Connection (REQUIRED)
# Account identifier format: <account>.<region>.aws (or .azure, .gcp)
# Example: hz93433.ap-southeast-7.aws
SNOWFLAKE_ACCOUNT=your-account.region.aws

# Username MUST be full email address for authentication
# Example: your-email@gmail.com
SNOWFLAKE_USERNAME=your-email@gmail.com

# Password for Snowflake authentication
SNOWFLAKE_PASSWORD=your-password-here

SNOWFLAKE_WAREHOUSE=SNOWFLAKE_LEARNING_WH
SNOWFLAKE_DATABASE=SIGNALMESH_AI
SNOWFLAKE_SCHEMA=DISASTER_RISK

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (frontend URL)
CORS_ORIGIN=http://localhost:3000

# API Configuration
API_TIMEOUT=30000
CACHE_TTL=300000
