# SignalMesh AI Backend — Environment Configuration
# Copy this file to .env and fill in your actual Snowflake credentials
# NEVER commit .env to git — it is git-ignored for security

# Snowflake Connection (REQUIRED)
# Account identifier format: <account>.<region>.aws (or .azure, .gcp)
# Example: hz93433.ap-southeast-7.aws
SNOWFLAKE_ACCOUNT=your-account.region.aws

# Username MUST be full email address for authentication
# Example: your-email@gmail.com
SNOWFLAKE_USERNAME=your-email@gmail.com

# Password for Snowflake authentication
SNOWFLAKE_PASSWORD=your-password-here

SNOWFLAKE_WAREHOUSE=SNOWFLAKE_LEARNING_WH
SNOWFLAKE_DATABASE=SIGNALMESH_AI
SNOWFLAKE_SCHEMA=DISASTER_RISK

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (frontend URL)
CORS_ORIGIN=http://localhost:3000

# API Configuration
API_TIMEOUT=30000
CACHE_TTL=300000

# Emergency Alert System
# Base URL for alert links (change to your deployed URL or machine IP for mobile access)
ALERT_BASE_URL=http://localhost:3000

# Twilio SMS Configuration (Optional - for SMS alerts)
# Sign up at https://www.twilio.com to get these credentials
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Mobile Phone Alert Configuration (Optional - for ADB connection)
# Set to your local machine's IP address for mobile phone access
# Find with: ipconfig (Windows) or ifconfig (Mac/Linux)
# PHONE_IP=192.168.1.100
